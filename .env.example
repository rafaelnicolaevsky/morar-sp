# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA versionar o .env real (já está no .gitignore).

# Token de acesso gerado no painel Meta for Developers
# (App "Morar SP" > API do Instagram > Configuração da API com login > 2. Gerar tokens de acesso)
INSTAGRAM_ACCESS_TOKEN=

# ID da conta do Instagram (Instagram Business Account ID)
INSTAGRAM_ACCOUNT_ID=17841438460511613

# ID do app Instagram (aparece no painel, não é segredo, mas mantemos junto por organização)
INSTAGRAM_APP_ID=1296129422598897

# Chave da API da Anthropic (console.anthropic.com), usada pela etapa 2
# (scripts/02_gerar_copy.py) para gerar o texto do post via Claude
ANTHROPIC_API_KEY=

# Caminho local do repositório morar-sp-midia (hospeda as imagens do
# carrossel publicamente para a Instagram Graph API). Padrão: pasta irmã
# deste projeto. Só precisa preencher se o caminho for outro.
MIDIA_REPO_PATH=../morar-sp-midia

# Access Key do Unsplash (unsplash.com/developers > Your apps > New Application)
# Usada pela etapa 3 para buscar a foto de fundo dos slides
UNSPLASH_ACCESS_KEY=
