# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA versionar o .env real (já está no .gitignore).

# Token de acesso gerado no painel Meta for Developers
# (App "Morar SP" > API do Instagram > Configuração da API com login > 2. Gerar tokens de acesso)
INSTAGRAM_ACCESS_TOKEN=

